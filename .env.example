APP_NAME=Keroyok.AI Backend
APP_ENV=local
API_V1_PREFIX=/api/v1
CONTEXT_BANK_DIR=./data/context_bank

# Enable the Microsoft Agent Framework runtime when Azure is configured.
USE_MICROSOFT_AGENT_FRAMEWORK=true

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optional. Leave blank to use the SDK default when supported.
AZURE_OPENAI_API_VERSION=
AZURE_USE_DEFAULT_CREDENTIAL=false

# Azure AI Search
AZURE_AI_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX_NAME=keroyok-context-bank
AZURE_AI_SEARCH_VECTOR_DIMENSIONS=1536

